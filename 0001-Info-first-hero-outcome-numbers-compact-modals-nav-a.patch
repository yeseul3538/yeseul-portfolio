+  #stack .grid-3 > .stack-card:nth-child(n) { grid-column: 1; grid-row: auto; padding-left: 0; border-left: 0; }
+  #stack .grid-3 > .stack-card + .stack-card { margin-top: 24px; padding-top: 24px; border-top: 1px solid var(--line); }
