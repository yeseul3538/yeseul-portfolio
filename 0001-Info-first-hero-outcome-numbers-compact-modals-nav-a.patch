+.d-pair { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 14px; margin-bottom: 14px; }
+.d-pair > .d-note { margin: 0; }
+.d-note.d-roles ul { display: flex; flex-direction: row; flex-wrap: wrap; gap: 8px; padding: 0; list-style: none; }
+.d-note.d-roles li { display: inline-block; width: auto; margin: 0; padding-left: 12px; padding: 6px 12px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); font-size: 14px; line-height: 1.45; }
+.d-note.d-roles li::before { display: none; }
+.d-figure { box-shadow: none; border-radius: 6px; }
+
+/* 도구: 2단 — 왼쪽 자동화 + 기획·협업, 오른쪽 도메인 이해 */
+#stack .grid-3 { grid-template-columns: 1fr 1fr; }
+#stack .grid-3 > .stack-card:nth-child(1) { grid-column: 1; grid-row: 1; padding-left: 0; }
+#stack .grid-3 > .stack-card:nth-child(2) { grid-column: 2; grid-row: 1 / span 2; border-left: 1px solid var(--line); }
+#stack .grid-3 > .stack-card:nth-child(3) { grid-column: 1; grid-row: 2; padding-left: 0; border-left: 0; margin-top: 8px; padding-top: 24px; border-top: 1px solid var(--line); }
+
+/* 연락처: 값이 단어 중간에서 끊기지 않게 — 폭이 모자라면 카드가 다음 줄로 */
+.contact-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
+@media (max-width: 860px) { .contact-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
+@media (max-width: 560px) { .contact-grid { grid-template-columns: 1fr; } }
+.contact-card span, .contact-card b, .contact-card strong { white-space: nowrap; word-break: keep-all; overflow-wrap: normal; }
+
+@media (max-width: 1080px) {
+  .work-card:not(.is-compact) { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px 32px; }
+  .work-figure { grid-column: 1 / -1; flex-direction: row; align-items: baseline; flex-wrap: wrap; gap: 4px 14px; padding: 0 0 16px; border-right: 0; border-bottom: 1px solid var(--line); }
+}
+@media (max-width: 860px) {
+  .work-card:not(.is-compact) { grid-template-columns: 1fr; }
+  .wf-n { font-size: 24px; white-space: normal; }
+  .d-asis { grid-template-columns: 1fr; }
+  .d-asis > div + div { border-left: 0; border-top: 1px solid var(--line); }
+  .d-asis > div + div::before { left: 24px; top: -7px; margin-top: 0; transform: rotate(135deg); }
+  .d-asis .is-to { border-radius: 0 0 6px 6px; }
